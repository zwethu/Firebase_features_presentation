rules_version = '2';

// Firebase Feature Lab — Cloud Storage Security Rules
//
// Default-deny posture: only the /storage demo's upload path is matched
// below; the trailing catch-all denies everything else, including the old
// StudyFlow AI `assignments/{uid}/{assignmentId}/{fileName}` path from the
// retired product.
//
// Path layout: feature-lab/{uid}/uploads/{fileName}

service firebase.storage {
  match /b/{bucket}/o {

    match /feature-lab/{uid}/uploads/{fileName} {
      // Owner-only read for this demo — a presenter showing "your own
      // upload" is enough; there is no cross-user file sharing feature.
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType in ['application/pdf', 'image/png', 'image/jpeg']
        && request.resource.size <= 10 * 1024 * 1024
        // The {fileName} wildcard already matches exactly one path segment
        // (it structurally cannot contain "/", so traversal via "../" is
        // not possible here), but this still guards against control
        // characters or unexpected names slipping into the object path.
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$');
    }

    // Everything else is closed by default — never leave Storage in
    // public test mode.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

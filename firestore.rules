rules_version = '2';

// StudyFlow AI Firestore Security Rules
//
// Assumptions documented here (see README.md "Security warnings and known
// limitations" for the full write-up):
//
// 1. Admin access is simplified for the demo: it is granted via
//    `users/{uid}.role == "admin"`, a Firestore field the user themself
//    cannot write (see the `users` rules below — only the `role` field on
//    someone ELSE's document is writable by an admin; every user can only
//    create/update their own document and can never change their own
//    `role`). For a real production deployment, prefer a Firebase
//    Authentication CUSTOM CLAIM (`request.auth.token.admin == true`) set
//    via the Admin SDK, since a custom claim can't be altered by a client
//    write in any way. This demo simplification is called out explicitly
//    so it is never mistaken for a production-ready pattern.
// 2. Cloud Functions (Admin SDK) bypass these rules entirely — the
//    `onSubmissionCreated` / `onAnnouncementCreated` triggers always have
//    full access regardless of what's written below.
// 3. Every collection requires `request.auth != null` at minimum; there is
//    no public/test-mode access anywhere in this file.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions live inside this match block (not at file scope) so
    // that `database` — bound by the `{database}` wildcard above — is in
    // scope for the `get()` calls below. Declaring them at file scope would
    // leave `database` unbound inside `get(/databases/$(database)/...)`.
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Deliberately avoids a ternary around get() — the rules emulator (as
    // of firebase-tools 15.x) throws "ternary operator predicate is always
    // boolean" for that shape. isSignedIn() is checked first via `&&`
    // short-circuiting instead, which is both emulator-safe and cheaper
    // (no extra Firestore read for anonymous/signed-out requests).
    function hasRole(role) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacherOf(courseId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.teacherId == request.auth.uid;
    }

    function isStudentOf(courseId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.studentIds;
    }

    // users/{uid} — everyone can read their own profile; teachers/admins
    // may need to read a student's display name, so reads are allowed to
    // any signed-in user (display name/photo are not sensitive) but writes
    // are locked to the owner, and the owner can never change their own
    // `role` (that would be self-granted privilege escalation).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) && request.resource.data.role == 'student';
      allow update: if isSelf(uid) && request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // courses/{courseId}
    match /courses/{courseId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacherId == request.auth.uid ||
        request.auth.uid in resource.data.studentIds
      );
      allow create: if hasRole('teacher') || isAdmin();
      allow update, delete: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // assignments/{assignmentId}
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (
        isAdmin() || isTeacherOf(resource.data.courseId) || isStudentOf(resource.data.courseId)
      );
      allow create: if isSignedIn() && (isTeacherOf(request.resource.data.courseId) || isAdmin());
      allow update, delete: if isSignedIn() && (isTeacherOf(resource.data.courseId) || isAdmin());
    }

    // submissions/{submissionId}
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.studentId == request.auth.uid || isTeacherOf(resource.data.courseId)
      );
      allow create: if isSignedIn() &&
        request.resource.data.studentId == request.auth.uid &&
        isStudentOf(request.resource.data.courseId);
      // Submissions are immutable once created — status changes for a real
      // grading workflow are out of scope for this demo.
      allow update, delete: if false;
    }

    // announcements/{announcementId}
    match /announcements/{announcementId} {
      allow read: if isSignedIn() && (
        isAdmin() || isTeacherOf(resource.data.courseId) || isStudentOf(resource.data.courseId)
      );
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        isTeacherOf(request.resource.data.courseId);
      allow update, delete: if isSignedIn() && (isTeacherOf(resource.data.courseId) || isAdmin());
    }

    // notifications/{notificationId} — a user may only read/update their
    // own notifications, and may only ever flip `read` to true.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Client writes are otherwise disallowed — notifications are created
      // by Cloud Functions (Admin SDK, which bypasses these rules).
      allow create, delete: if false;
    }

    // aiChats/{chatId} — minimal demo chat history, owner-only.
    match /aiChats/{chatId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // courseSummaries/{courseId} — written only by Cloud Functions.
    match /courseSummaries/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}

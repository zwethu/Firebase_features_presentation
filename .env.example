# Public Firebase Web SDK configuration.
# These values are safe to ship to the browser — they identify the Firebase
# project, they do not grant access on their own. Access is controlled by
# Firebase Authentication + Security Rules + App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Realtime Database URL (only needed if you enable optional presence).
VITE_FIREBASE_DATABASE_URL=

# Demo/presentation mode. When true: seeded demo data, role switcher UI,
# and relaxed Remote Config fetch intervals are enabled. Set to false for a
# real production deployment.
VITE_DEMO_MODE=true

# reCAPTCHA v3 site key for Firebase App Check (leave empty to run in
# App Check "not configured" state, or use the debug provider in dev).
VITE_APP_CHECK_SITE_KEY=

# Firebase Cloud Messaging Web Push certificate (VAPID) key. Optional —
# in-app notifications work without it.
VITE_FCM_VAPID_KEY=

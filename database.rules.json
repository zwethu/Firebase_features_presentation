{
  "rules": {
    "featureLab": {
      "reactions": {
        "firebase": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'displayName'])"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
